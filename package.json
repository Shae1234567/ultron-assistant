{
  "name": "ultron",
  "productName": "Ultron",
  "private": true,
  "version": "1.0.0",
  "description": "A desktop AI command center: an animated HUD, a team of seven AI agents, long-term memory in an Obsidian vault, and your apps through Composio. Bring your own AI: Gemini, OpenAI-compatible, Anthropic or a local model.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --win --dir",
    "postinstall": "playwright install chromium",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.130.0",
    "@composio/core": "^0.21.0",
    "@google/genai": "^1.52.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.140.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@mozilla/readability": "^0.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vectorize-io/hindsight-client": "^0.10.2",
    "@vitejs/plugin-react": "^4.3.3",
    "@xenova/transformers": "^2.17.2",
    "chrono-node": "^2.10.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "framer-motion": "^11.11.17",
    "mathjs": "^15.2.0",
    "minisearch": "^7.2.0",
    "png-to-ico": "^3.0.2",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "com.ultron.assistant",
    "productName": "Ultron",
    "executableName": "Ultron",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build-assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "pytools",
        "to": "pytools",
        "filter": [
          "*.py"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/playwright-core/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build-assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Ultron",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Ultron-Setup-${version}.${ext}"
    }
  },
  "author": "The Ultron authors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shae1234567/ultron-assistant.git"
  },
  "homepage": "https://github.com/Shae1234567/ultron-assistant"
}
